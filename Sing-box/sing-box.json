    "route": {
        "rule_set": [
            {
                "tag": [
                    "netflix", "spotify", "binance", "bybit",
                    "category-cryptocurrency", "youtube", "google",
                    "microsoft", "onedrive", "github", "twitter",
                    "twitch", "meta", "bahamut", "disney",
                    "primevideo", "hbo", "tiktok", "amazon@cn",
                    "amazon", "category-media-cn", "category-media",
                    "apple", "geolocation-cn",
                    "category-httpdns-cn@ads"
                ],
                "type": "remote", "format": "binary",
                "url": "https://github.com/SagerNet/sing-geosite/raw/rule-set/geosite-{tag}.srs"
            },
            {
                "tag": ["category-ai-!cn", "cn", "geolocation-!cn"],
                "type": "remote", "format": "binary",
                "url": "https://github.com/MetaCubeX/meta-rules-dat/raw/sing/geo/geosite/{tag}.srs"
            },
            {
                "tag": ["Telegram", "Epic", "Steam", "Ads_SukkaW"],
                "type": "remote", "format": "binary",
                "url": "https://github.com/Repcz/Tool/raw/X/sing-box/Rules/{tag}.srs"
            },
            {
                "tag": ["UnBan", "Emby", "FixProxy"],
                "type": "remote", "format": "binary",
                "url": "https://github.com/MESSIUINIMI/ioss/raw/main/Sing-box/ruleset/{tag}.srs"
            },
            {"tag": "CNIP","type": "remote","format": "binary","url": "https://github.com/Loyalsoldier/geoip/raw/release/srs/cn.srs"}
        ],
        "rules": [
            {"action": "sniff","sniffer": ["http","tls","quic","dns"],"timeout": "500ms"},
            {"protocol": "dns","action": "hijack-dns"},
            {"ip_is_private": true,"action": "route","outbound": "🎯 Direct"},
            {"clash_mode": "❌ Direct","action": "route","outbound": "🎯 Direct"},
            {"clash_mode": "🌍 Global","action": "route","outbound": "🖲 Proxy"},
            {"rule_set": ["Ads_SukkaW","category-httpdns-cn@ads"],"action": "reject"},
            {"rule_set": ["UnBan"],"action": "route","outbound": "🎯 Direct"},
            {"rule_set": ["category-ai-!cn"],"action": "route","outbound": "🧠 AI"},
            {"rule_set": ["netflix"],"action": "route","outbound": "🖥 Netflix"},
            {"rule_set": ["youtube"],"action": "route","outbound": "🎬 YouTube"},
            {"rule_set": ["spotify"],"action": "route","outbound": "🎧 Spotily"},
            {"rule_set": ["binance","category-cryptocurrency"],"action": "route","outbound": "🪙 Crypto"},
            {"rule_set": ["bybit"],"action": "route","outbound": "💳 Bybit"},
            {"rule_set": ["google"],"action": "route","outbound": "🔍 Google"},
            {"rule_set": ["microsoft","onedrive","github"],"action": "route","outbound": "🗂️ Microsoft"},
            {"rule_set": ["twitter"],"action": "route","outbound": "𝕏 Twitter"},
            {"rule_set": ["Telegram"],"action": "route","outbound": "📱 Telegram"},
            {"rule_set": ["amazon@cn"],"action": "route","outbound": "🎯 Direct"},
            {"rule_set": ["amazon"],"action": "route","outbound": "☁️ Amazon"},
            {"rule_set": ["twitch"],"action": "route","outbound": "🔴 Twitch"},
            {"rule_set": ["meta"],"action": "route","outbound": "Ⓜ️ Meta"},
            {"rule_set": ["Emby"],"action": "route","outbound": "🎉 Emby"},
            {"rule_set": ["FixProxy"],"action": "route","outbound": "🖲 Proxy"},
            {"rule_set": ["Steam","Epic"],"action": "route","outbound": "🎮 Game"},
            {"rule_set": ["category-media-cn"],"action": "route","outbound": "🎯 Direct"},
            {"rule_set": ["bahamut","disney","primevideo","hbo","tiktok","category-media"],"action": "route","outbound": "📺 GlobalMedia"},
            {"rule_set": ["apple"],"action": "route","outbound": "🍎 Apple"},
            {"rule_set": ["geolocation-cn","cn"],"action": "route","outbound": "🎯 Direct"},
            {"rule_set": ["geolocation-!cn"],"action": "route","outbound": "🖲 Proxy"},
            {"rule_set": ["CNIP"],"action": "route","outbound": "🎯 Direct"}
        ],
        "auto_detect_interface": true,
        "default_domain_resolver": "AQUIC",
        "default_http_client": "rule-set-download",
        "final": "🕹 Final"
    },
    "log": {
        "disabled": false,
        "level": "info",
        "output": "sing-box.log",
        "timestamp": true
    },
    "http_clients": [
        {
            "tag": "rule-set-download",
            "version": 2,
            "detour": "🇺🇸 US"
        }
    ],
    "services": [
        {
            "type": "api",
