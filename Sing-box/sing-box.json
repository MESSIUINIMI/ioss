  ["geolocation-cn","cn"],"action":
  "evaluate","server": "AQUIC","tag": "aquic"},
          {"rule_set":
  ["geolocation-cn","cn"],"action":
  "evaluate","server": "TDOH","tag": "tdoh"},
          {"rule_set":
  ["geolocation-cn","cn"],"match_response":
  "aquic","response_rcode": "NOERROR","action":
  "respond","race": true},
          {"rule_set":
  ["geolocation-cn","cn"],"match_response":
  "tdoh","response_rcode": "NOERROR","action":
      "reverse_mapping": true,
      "optimistic": true,
      "final": "GH3"
