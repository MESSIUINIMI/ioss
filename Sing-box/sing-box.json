  ent.com","10099.com.cn","msftconnecttest.com",
  "msftncsi.com","local","lan","home","internal"
  ,"corp","example.com"],"server": "local"},
          {"query_type": ["A","AAAA"],"action":
  "route","server": "Fakeip","rewrite_ttl": 1},
